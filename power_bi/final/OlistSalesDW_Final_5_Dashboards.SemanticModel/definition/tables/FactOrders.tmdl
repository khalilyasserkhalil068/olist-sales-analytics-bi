table FactOrders
	lineageTag: 8f79cb02-6174-43b3-82a9-9216111a975f

	/// Order-grain count. Responds to customer, status, purchase date and order; product/seller filters apply only to item measures.
	measure 'Order Count' = COUNTROWS(FactOrders)
		formatString: #,0
		displayFolder: Validated KPIs
		lineageTag: 4ffdb9bc-4a12-4505-857b-68fb7ea1a304

	/// Sales-eligible orders at order grain.
	measure 'Sales Order Count' = CALCULATE(COUNTROWS(FactOrders), KEEPFILTERS(FactOrders[SalesEligible]=TRUE()))
		formatString: #,0
		displayFolder: Validated KPIs
		lineageTag: 81ca6f37-0118-490f-91f1-492e0de75453

	/// Eligible on-time orders divided by eligible delivered orders; excludes missing/ineligible delivery records.
	measure 'On Time Delivery Rate' = DIVIDE(CALCULATE(COUNTROWS(FactOrders),KEEPFILTERS(FactOrders[OnTimeEligible]=TRUE()),KEEPFILTERS(FactOrders[IsOnTime]=TRUE())),CALCULATE(COUNTROWS(FactOrders),KEEPFILTERS(FactOrders[OnTimeEligible]=TRUE())))
		formatString: 0.00%
		displayFolder: Validated KPIs
		lineageTag: 7fd122e3-4077-4f21-9a04-ae4a2a6aa009

	/// Average duration over duration-eligible orders only.
	measure 'Average Delivery Days' = CALCULATE(AVERAGE(FactOrders[DeliveryDurationDays]),KEEPFILTERS(FactOrders[DurationEligible]=TRUE()))
		formatString: 0.00
		displayFolder: Validated KPIs
		lineageTag: cb299ea2-aeeb-4808-9126-0e43411b5e74

	/// Distinct known CustomerUniqueID identities with sales-eligible orders in the current selection. Filters FactOrders first, then transfers its customer keys to DimCustomer with TREATAS. Not distinct CustomerID, not unfiltered dimension population.
	measure 'Unique Sales Customers' = VAR EligibleCustomerKeys = CALCULATETABLE(VALUES(FactOrders[CustomerKey]), KEEPFILTERS(FactOrders[SalesEligible] = TRUE())) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(DimCustomer[CustomerUniqueID]), KEEPFILTERS(TREATAS(EligibleCustomerKeys, DimCustomer[CustomerKey])), KEEPFILTERS(DimCustomer[CustomerKey] <> 0), KEEPFILTERS(NOT ISBLANK(DimCustomer[CustomerUniqueID]))), 0)
		formatString: #,0
		displayFolder: Dashboard KPIs
		lineageTag: 32ea1940-f608-4076-a452-864f880c6309

	/// Known customer identities with at least two distinct sales-eligible OrderKey values within the current selected dates and geography. Observed repeat purchasing, not cohort retention or lifetime behavior.
	measure 'Repeat Sales Customers' = VAR IdentityOrders = CALCULATETABLE(SUMMARIZE(FactOrders, DimCustomer[CustomerUniqueID], "__Orders", DISTINCTCOUNT(FactOrders[OrderKey])), KEEPFILTERS(FactOrders[SalesEligible] = TRUE()), KEEPFILTERS(DimCustomer[CustomerKey] <> 0), KEEPFILTERS(NOT ISBLANK(DimCustomer[CustomerUniqueID]))) RETURN COALESCE(COUNTROWS(FILTER(IdentityOrders, [__Orders] >= 2)), 0)
		formatString: #,0
		displayFolder: Dashboard KPIs
		lineageTag: 4b5d2f7f-c6de-44f5-9447-158cffd4325d

	/// Identities with exactly one eligible purchase in the current selection. One-time refers only to this selected observation window, not first-ever purchase or churn.
	measure 'One-Time Sales Customers' = [Unique Sales Customers] - [Repeat Sales Customers]
		formatString: #,0
		displayFolder: Dashboard KPIs
		lineageTag: a3baf3dc-a6d2-4d3a-8e28-baf3fd582e99

	/// Repeat eligible identities divided by all known eligible identities within the current selection. Nonadditive across geography and time; not a retention rate.
	measure 'Repeat Customer Rate' = DIVIDE([Repeat Sales Customers], [Unique Sales Customers])
		formatString: 0.00%
		displayFolder: Dashboard KPIs
		lineageTag: da8a5b61-8d04-4330-8f6e-f809ff573ff0

	/// Sales-eligible order count for known identities divided by unique eligible identities, within the selected observation window.
	measure 'Customer Order Frequency' = DIVIDE(CALCULATE([Sales Order Count], KEEPFILTERS(DimCustomer[CustomerKey] <> 0), KEEPFILTERS(NOT ISBLANK(DimCustomer[CustomerUniqueID]))), [Unique Sales Customers])
		formatString: 0.00
		displayFolder: Dashboard KPIs
		lineageTag: 33c7f1fa-ccd5-42cd-803b-8751d117f7a6

	/// Eligible item revenue associated with known customer identities divided by distinct eligible identities. Preserves item-grain Sales Revenue; never sums order revenue into item revenue.
	measure 'Sales Revenue per Customer' = DIVIDE(CALCULATE([Sales Revenue], KEEPFILTERS(DimCustomer[CustomerKey] <> 0), KEEPFILTERS(NOT ISBLANK(DimCustomer[CustomerUniqueID]))), [Unique Sales Customers])
		formatString: "R$" #,0.00
		displayFolder: Dashboard KPIs
		lineageTag: d41632b8-2d6a-4f29-a680-41ab1672374a

	/// Distinct nonblank approximate ZIP-lookup states with known eligible customer identities in the current selection. Unknown geography is retained in other visuals but is not counted as a state.
	measure 'Customer States with Sales' = COALESCE(COUNTROWS(FILTER(VALUES(DimCustomerGeography[ApproximateState]), NOT ISBLANK(DimCustomerGeography[ApproximateState]) && [Unique Sales Customers] > 0)), 0)
		formatString: #,0
		displayFolder: Dashboard KPIs
		lineageTag: 131fc245-608d-4ed3-a973-f8dbdb9ec252

	/// Approximate customer state with the highest eligible item revenue in the current selection; deterministic alphabetical tie-break. Blank when there are no positive-revenue known states.
	measure 'Top Customer State' = VAR StateRevenue = FILTER(ADDCOLUMNS(VALUES(DimCustomerGeography[ApproximateState]), "__Revenue", [Sales Revenue]), NOT ISBLANK(DimCustomerGeography[ApproximateState]) && [__Revenue] > 0) RETURN CONCATENATEX(TOPN(1, StateRevenue, [__Revenue], DESC, DimCustomerGeography[ApproximateState], ASC), DimCustomerGeography[ApproximateState], ", ")
		displayFolder: Dashboard KPIs
		lineageTag: 21882d2c-dc89-425c-b9f7-d7edb349d82b

	/// Revenue of the top nonblank approximate customer state in the current selection; supporting tooltip for Top Customer State.
	measure 'Top Customer State Revenue' = MAXX(FILTER(VALUES(DimCustomerGeography[ApproximateState]), NOT ISBLANK(DimCustomerGeography[ApproximateState])), [Sales Revenue])
		formatString: "R$" #,0.00
		displayFolder: Dashboard KPIs
		lineageTag: e74a5035-d36b-4024-a728-5481b0748377

	/// Regional eligible revenue divided by revenue across the selected visible regions, preserving purchase-date, state and city slicers. Requires the proposed Customer Region display attribute.
	measure 'Customer Region Revenue Share' = DIVIDE([Sales Revenue], CALCULATE([Sales Revenue], ALLSELECTED(DimCustomerGeography[Customer Region])))
		formatString: 0.0%
		displayFolder: Dashboard KPIs
		lineageTag: cc43f012-4d9f-4147-ad0d-5f25fcd423a6

	/// Visual-only exact Top 10 city/state groups by eligible Sales Revenue within slicer selection, alphabetical tie-break. Use filter equals1 only on city visual, never page/report. Do not add other geography fields as tooltip grouping columns.
	measure 'Show Top 10 Customer Cities' = VAR Candidates = FILTER(ADDCOLUMNS(ALLSELECTED(DimCustomerGeography[Customer City State]), "__Revenue", [Sales Revenue]), [__Revenue] > 0) VAR Leaders = TOPN(10, Candidates, [__Revenue], DESC, DimCustomerGeography[Customer City State], ASC) VAR ThisCity = SELECTEDVALUE(DimCustomerGeography[Customer City State]) RETURN IF(ISINSCOPE(DimCustomerGeography[Customer City State]) && CONTAINS(Leaders, DimCustomerGeography[Customer City State], ThisCity), 1, 0)
		formatString: 0
		displayFolder: Dashboard KPIs
		lineageTag: e1e68905-7fd0-458d-b113-a1505633e4e6

	/// All orders whose status is delivered. This includes delivered orders missing actual delivery dates; SLA eligibility is a separate denominator.
	measure 'Delivered Orders' = CALCULATE(COUNTROWS(FactOrders), KEEPFILTERS(DimOrderStatus[OrderStatus] = "delivered"))
		formatString: #,0
		displayFolder: Completion KPIs
		lineageTag: 9f7898b3-fa43-4fb1-827e-ab2daec2f352

	/// Delivered orders with actual and estimated delivery timestamps, using the preserved warehouse eligibility contract.
	measure 'Timeliness Eligible Orders' = CALCULATE(COUNTROWS(FactOrders), KEEPFILTERS(FactOrders[OnTimeEligible] = TRUE()))
		formatString: #,0
		displayFolder: Completion KPIs
		lineageTag: 3da80ef0-a458-47f2-b8bc-88c0ed554ce3

	/// Eligible orders delivered on or before estimated calendar date; preserves the original KPI.
	measure 'On Time Deliveries' = CALCULATE([Timeliness Eligible Orders], KEEPFILTERS(FactOrders[IsOnTime] = TRUE()))
		formatString: #,0
		displayFolder: Completion KPIs
		lineageTag: 80da46f7-39a1-4bbc-acf1-ce5036b763c8

	/// Eligible delivered orders after the estimated calendar date. Undelivered orders never enter this count.
	measure 'Late Deliveries' = CALCULATE([Timeliness Eligible Orders], KEEPFILTERS(FactOrders[IsOnTime] = FALSE()))
		formatString: #,0
		displayFolder: Completion KPIs
		lineageTag: 18272e09-8107-4efe-8e6c-f787689757ad

	/// Late deliveries / timeliness-eligible deliveries under the current filters.
	measure 'Late Delivery Rate' = DIVIDE([Late Deliveries], [Timeliness Eligible Orders])
		formatString: 0.00%
		displayFolder: Completion KPIs
		lineageTag: 7b947d9a-8c67-48cd-8eb9-5b810aed1d2c

	/// Sum the once-per-order aggregated freight for delivered orders. Never join freight to reviews or items for this measure.
	measure 'Delivered Freight Amount' = CALCULATE(SUM(FactOrders[FreightAmount]), KEEPFILTERS(DimOrderStatus[OrderStatus] = "delivered"))
		formatString: "R$" #,0.00
		displayFolder: Completion KPIs
		lineageTag: a78f3d07-f035-41f3-8a27-114513455dd9

	/// Delivered order freight divided by all delivered orders, including zero-freight orders.
	measure 'Average Freight per Delivered Order' = DIVIDE([Delivered Freight Amount], [Delivered Orders])
		formatString: "R$" #,0.00
		displayFolder: Completion KPIs
		lineageTag: 37e7c4c9-1a44-488d-856b-4029538003cb

	/// Mean calendar-day lateness among eligible late orders. Different from elapsed purchase-to-delivery duration.
	measure 'Average Late Delay Days' = AVERAGEX(FILTER(FactOrders, FactOrders[OnTimeEligible] = TRUE() && FactOrders[IsOnTime] = FALSE()), INT(FactOrders[ActualDeliveryTimestamp]) - INT(FactOrders[EstimatedDeliveryTimestamp]))
		formatString: 0.00
		displayFolder: Completion KPIs
		lineageTag: 7f4db33a-3a43-40e6-bd6f-ddb7993944e9

	/// Delivered orders with valid chronology and usable purchase and actual timestamps, matching the existing duration contract.
	measure 'Duration Eligible Orders' = CALCULATE(COUNTROWS(FactOrders), KEEPFILTERS(FactOrders[DurationEligible] = TRUE()))
		formatString: #,0
		displayFolder: Completion KPIs
		lineageTag: 2c4f8ccb-9ee6-4f5d-8e7f-bd908baa4b18

	/// Distinct order-key semijoin from items to orders. A multi-category order contributes once to each applicable category; categories are non-additive.
	measure 'Category On Time Delivery Rate' = VAR OrdersInCategory = VALUES(FactOrderItems[OrderKey]) RETURN CALCULATE([On Time Delivery Rate], KEEPFILTERS(TREATAS(OrdersInCategory, FactOrders[OrderKey])))
		formatString: 0.00%
		displayFolder: Completion KPIs
		lineageTag: 2b3bae50-aef5-4e6c-afc2-6738281baa75

	/// Timeliness denominator within each category using a distinct order-key semijoin.
	measure 'Category Eligible Deliveries' = VAR OrdersInCategory = VALUES(FactOrderItems[OrderKey]) RETURN CALCULATE([Timeliness Eligible Orders], KEEPFILTERS(TREATAS(OrdersInCategory, FactOrders[OrderKey])))
		formatString: #,0
		displayFolder: Completion KPIs
		lineageTag: 94ba5e49-be62-4054-bc88-451a5363ff08

	/// Visual-only exact Top 10 by selected population volume; alphabetical tie-break. Never apply at page/report level.
	measure 'Show Delivery Top 10 States' = VAR Candidates = FILTER(ADDCOLUMNS(ALLSELECTED(DimCustomerGeography[ApproximateState]), "__Volume", [Delivered Orders]), NOT ISBLANK(DimCustomerGeography[ApproximateState]) && [__Volume] > 0) VAR Leaders = TOPN(10, Candidates, [__Volume], DESC, DimCustomerGeography[ApproximateState], ASC) VAR CurrentGroup = SELECTEDVALUE(DimCustomerGeography[ApproximateState]) RETURN IF(ISINSCOPE(DimCustomerGeography[ApproximateState]) && CONTAINS(Leaders, DimCustomerGeography[ApproximateState], CurrentGroup), 1, 0)
		formatString: 0
		displayFolder: Completion KPIs
		lineageTag: c26c170e-0f3b-4b9d-a175-9d5994c42985

	/// Visual-only exact Top 10 by selected population volume; alphabetical tie-break. Never apply at page/report level.
	measure 'Show Delivery Top 10 Categories' = VAR Candidates = FILTER(ADDCOLUMNS(ALLSELECTED(DimProduct[CategoryLabel]), "__Volume", [Category Eligible Deliveries]), NOT ISBLANK(DimProduct[CategoryLabel]) && [__Volume] > 0) VAR Leaders = TOPN(10, Candidates, [__Volume], DESC, DimProduct[CategoryLabel], ASC) VAR CurrentGroup = SELECTEDVALUE(DimProduct[CategoryLabel]) RETURN IF(ISINSCOPE(DimProduct[CategoryLabel]) && CONTAINS(Leaders, DimProduct[CategoryLabel], CurrentGroup), 1, 0)
		formatString: 0
		displayFolder: Completion KPIs
		lineageTag: 5fa4159d-8de3-4393-b0b1-fc39413afdd8

