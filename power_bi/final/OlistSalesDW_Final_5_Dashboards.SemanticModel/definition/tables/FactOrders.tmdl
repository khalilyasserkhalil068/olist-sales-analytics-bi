		annotation SummarizationSetBy = Automatic

	/// Calendar-date SLA classification. Not eligible includes undelivered or missing-date orders; never relabel them late.
	column 'Delivery Timeliness' = IF(FactOrders[OnTimeEligible] = TRUE(), IF(FactOrders[IsOnTime] = TRUE(), "On time", "Late"), "Not eligible")
		dataType: string
		lineageTag: 9c1246e3-b98c-4317-beb8-e9a3d07c6574
		summarizeBy: none

	/// Elapsed-day duration bins, only for duration-eligible orders. Prefixes preserve chronological sort.
	column 'Delivery Duration Band' = IF(FactOrders[DurationEligible] <> TRUE(), BLANK(), SWITCH(TRUE(), FactOrders[DeliveryDurationDays] < 7, "01 | Under 7 days", FactOrders[DeliveryDurationDays] < 14, "02 | 7 to <14 days", FactOrders[DeliveryDurationDays] < 21, "03 | 14 to <21 days", FactOrders[DeliveryDurationDays] < 30, "04 | 21 to <30 days", "05 | 30+ days"))
		dataType: string
		lineageTag: 57f835f4-281c-496f-a8ee-3f8f092ee766
		summarizeBy: none

	partition FactOrders = m
		mode: import
		source =
				let
