/// Shipping deadline for order items. Separate active date role; missing dates appear under the relationship blank member.
table DimShippingLimitDate
	lineageTag: 8d795223-b887-4836-a065-1ccc7393d322
	dataCategory: Time

	column DateKey
		lineageTag: 48940d73-20b0-46b3-b0b5-02ba6bda6c99
		isNameInferred
		sourceColumn: DateKeyLookup[DateKey]

	column FullDate
		lineageTag: ee7ecc10-b241-432b-851d-8991436bf821
		isNameInferred
		sourceColumn: DateKeyLookup[FullDate]

	column Day
		lineageTag: 6278f456-3890-4993-b530-fed2ff245536
		isNameInferred
		sourceColumn: DateKeyLookup[Day]

	column Month
		lineageTag: 538c909e-4f23-4a73-a9cf-63e2bb1b8416
		isNameInferred
		sourceColumn: DateKeyLookup[Month]

	column MonthName
		lineageTag: 3fbbc44f-13ba-41c7-90cc-5da6bb33ecde
		isNameInferred
		sourceColumn: DateKeyLookup[MonthName]

	column Quarter
		lineageTag: b3fae156-af54-432e-89d4-ceccb23022e1
		isNameInferred
		sourceColumn: DateKeyLookup[Quarter]

	column Year
		lineageTag: 38dbe44f-c503-45a2-aca8-913d0c210e7d
		isNameInferred
		sourceColumn: DateKeyLookup[Year]

	column YearMonth
		lineageTag: b13f0b16-0c52-4ef0-bd87-4231645334ec
		isNameInferred
		sourceColumn: DateKeyLookup[YearMonth]

	column DayOfWeek
		lineageTag: 0f6acead-0a2f-4c4d-933b-f4b77bbcf54b
		isNameInferred
		sourceColumn: DateKeyLookup[DayOfWeek]

	column DayName
		lineageTag: 440d1891-aa28-4bb0-8d94-c613d11a2967
		isNameInferred
		sourceColumn: DateKeyLookup[DayName]

	column IsWeekend
		lineageTag: a9f81d32-585d-4634-b001-7d36f5674311
		isNameInferred
		sourceColumn: DateKeyLookup[IsWeekend]

	partition DimShippingLimitDate = calculated
		source = FILTER(DateKeyLookup, NOT ISBLANK(DateKeyLookup[FullDate]))

